# Firebase Configuration (Required for Vercel & Local)
# Get these values from Firebase Console > Project Settings > General
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_DATABASE_ID="(default)"

# Gemini AI API Key (Optional, for AI features)
GEMINI_API_KEY=""

# Vercel Deployment Note:
# 1. Add your Vercel domain (e.g., my-app.vercel.app) to:
#    Firebase Console > Authentication > Settings > Authorized Domains
# 2. Add the variables above to Vercel Project Settings > Environment Variables
